<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>마법의 고민 해결책</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Song+Myung&family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme: dark;
  --void:#150835; --deep:#2a0f5e; --violet:#5a2bb0; --glow:#8a5cf0;
  --silver:#e9e7f4; --silver-d:#a9a6c4;
  --paper:#f1ecf8; --ink:#2a1450;
  --f-display:"Song Myung","Nanum Myeongjo","Noto Serif KR",serif;
  --f-body:"Nanum Myeongjo","Noto Serif KR",serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  margin:0;min-height:100%;
  background:
    radial-gradient(ellipse 70% 55% at 50% 30%, var(--violet) 0%, transparent 70%),
    radial-gradient(ellipse 90% 70% at 50% 110%, #3a1580 0%, transparent 70%),
    linear-gradient(180deg,var(--void),var(--deep) 60%,#1d0a46);
  background-color:var(--void);
  color:var(--silver);font-family:var(--f-body);
  overflow-x:hidden;
}
#sky{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
main{
  position:relative;z-index:1;min-height:100dvh;
  display:flex;align-items:center;justify-content:center;
  padding:24px 16px;
}
.stage{width:100%;display:flex;flex-direction:column;align-items:center}
.stage[hidden]{display:none}

/* ---------- 입력 ---------- */
h1{
  margin:0 0 28px;font-family:var(--f-display);font-weight:400;
  font-size:clamp(2.4rem,9vw,4.6rem);letter-spacing:.06em;text-align:center;line-height:1.15;
  background:linear-gradient(100deg,#9591b8 15%,#ffffff 42%,#cfcbe6 55%,#8f8bb2 85%);
  background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 18px rgba(170,140,255,.55));
  animation:shimmer 6s linear infinite;
}
@keyframes shimmer{from{background-position:120% 0}to{background-position:-120% 0}}
.field{width:min(94vw,600px);position:relative}
textarea{
  width:100%;height:170px;resize:none;display:block;
  padding:20px 22px;font:inherit;font-size:1.1rem;line-height:1.8;color:var(--silver);
  background:rgba(20,6,50,.55);
  border:1px solid var(--silver-d);border-radius:2px;
  box-shadow:0 0 0 4px rgba(20,6,50,.4),0 0 40px rgba(138,92,240,.25) inset;
  clip-path:polygon(14px 0,calc(100% - 14px) 0,100% 14px,100% calc(100% - 14px),calc(100% - 14px) 100%,14px 100%,0 calc(100% - 14px),0 14px);
  transition:border-color .3s,box-shadow .3s;
}
textarea::placeholder{color:#8f8bb2}
textarea:focus{outline:none;border-color:#fff;box-shadow:0 0 0 4px rgba(20,6,50,.4),0 0 60px rgba(160,120,255,.45) inset,0 0 30px rgba(160,120,255,.5)}
.err{min-height:1.6em;margin:10px 0 0;font-size:.95rem;color:#ffd1f0;text-align:center}
.btn{
  font-family:var(--f-display);font-size:1.35rem;letter-spacing:.12em;color:var(--void);
  padding:13px 40px;border:0;cursor:pointer;
  background:linear-gradient(100deg,#b9b5d4,#ffffff 45%,#c9c5e2 60%,#a29ec5);
  border-radius:0;
  box-shadow:0 0 30px rgba(190,170,255,.6);
  transition:transform .2s,filter .2s;
}
.btn:hover{transform:translateY(-2px);filter:brightness(1.08)}
.btn:focus-visible,textarea:focus-visible{outline:2px solid #fff;outline-offset:4px}
.btn.ghost{background:transparent;color:var(--silver);border:1px solid var(--silver-d);clip-path:none;box-shadow:none;font-size:1.05rem;padding:10px 28px}
.shake{animation:shake .4s}
@keyframes shake{25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}

/* ---------- 책 ---------- */
.book{
  position:relative;width:min(94vw,760px);height:clamp(380px,64vw,480px);
  perspective:2400px;transform:translateX(-25%);
  transition:transform 1.1s cubic-bezier(.6,0,.2,1);
  filter:drop-shadow(0 30px 40px rgba(0,0,0,.5)) drop-shadow(0 0 40px rgba(150,110,255,.45));
}
.book.open{transform:none}
.book.reset,.book.reset *{transition:none!important}
.leaf{
  position:absolute;top:0;left:50%;width:50%;height:100%;
  transform-origin:left center;transform-style:preserve-3d;
  transition:transform .75s cubic-bezier(.45,.05,.3,1);
}
.leaf.flip{transform:rotateY(-180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden}
.face.back{transform:rotateY(180deg)}
.paper.front{
  border-radius:0 8px 8px 0;
  background:
    linear-gradient(90deg,rgba(60,30,110,.28),transparent 9%),
    repeating-linear-gradient(transparent 0 27px,rgba(90,50,160,.09) 27px 28px),var(--paper);
}
.paper.back{
  border-radius:8px 0 0 8px;
  background:
    linear-gradient(270deg,rgba(60,30,110,.28),transparent 9%),
    repeating-linear-gradient(transparent 0 27px,rgba(90,50,160,.09) 27px 28px),var(--paper);
}
.cover.front{
  border-radius:0 12px 12px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;
  background:radial-gradient(ellipse at 40% 30%,#5a25b8,#25095a 75%);
  box-shadow:inset 0 0 0 9px #22085a,inset 0 0 0 10px rgba(233,231,244,.8),inset 0 0 0 17px #22085a,inset 0 0 0 18px rgba(233,231,244,.35);
}
.cover .sig{font-size:clamp(2rem,6vw,3.4rem);color:var(--silver);text-shadow:0 0 18px #c9b8ff}
.cover .ttl{
  font-family:var(--f-display);font-size:clamp(1.3rem,4.4vw,2.3rem);line-height:1.4;letter-spacing:.1em;padding:0 22px;
  background:linear-gradient(100deg,#9c98be,#fff,#b8b4d6);-webkit-background-clip:text;background-clip:text;color:transparent;
}
.cover.back{border-radius:8px 0 0 8px;background:linear-gradient(270deg,#1b0645,#341275)}
.answer-page{
  position:absolute;top:0;left:50%;width:50%;height:100%;border-radius:0 8px 8px 0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:0 clamp(14px,4vw,40px);
  background:linear-gradient(90deg,rgba(60,30,110,.28),transparent 9%),repeating-linear-gradient(transparent 0 27px,rgba(90,50,160,.09) 27px 28px),var(--paper);
}
.answer-page .orn{color:#7a4fd0;font-size:1.3rem}
.answer{
  margin:0;color:var(--ink);font-weight:700;line-height:1.9;word-break:keep-all;
  font-size:clamp(.95rem,2.5vw,1.3rem);
  opacity:0;filter:blur(8px);transform:translateY(6px);
  transition:opacity 1.6s ease,filter 1.6s ease,transform 1.6s ease;
}
.answer.show{opacity:1;filter:blur(0);transform:none}
.worry{display:flex;flex-direction:column;justify-content:center;gap:12px;padding:0 clamp(14px,4vw,36px);text-align:center;color:var(--ink)}
.worry small{font-family:var(--f-display);font-size:1.05rem;color:#7a4fd0;letter-spacing:.1em}
.worry p{margin:0;line-height:1.8;font-size:clamp(.85rem,2.2vw,1.05rem);opacity:.85;display:-webkit-box;-webkit-line-clamp:7;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}
.spine{position:absolute;top:0;bottom:0;left:calc(50% - 1px);width:2px;background:rgba(40,15,90,.5);z-index:300;pointer-events:none;opacity:0;transition:opacity .6s 1s}
.book.open .spine{opacity:1}
.after{margin-bottom:20px;opacity:0;pointer-events:none;transition:opacity 1s}
.after.show{opacity:1;pointer-events:auto}


.book{cursor:pointer}.book:focus-visible{outline:2px solid #fff;outline-offset:8px}
.paper,.answer-page{box-shadow:inset 0 0 0 1px rgba(140,110,220,.45)}
#bgMagic{position:fixed;left:50%;top:50%;width:min(135vmin,1150px);aspect-ratio:1;transform:translate(-50%,-50%);color:#d4ccf7;opacity:.17;z-index:0;pointer-events:none;filter:drop-shadow(0 0 6px #9d7cff)}
#bgMagic svg,.mc svg{width:100%;height:100%;display:block}
.spin{transform-origin:500px 500px;animation:spin 140s linear infinite}
.mc .spin{animation-duration:60s}
@keyframes spin{to{transform:rotate(360deg)}}
.mc{width:76%;aspect-ratio:1;color:#e9e7f4;filter:drop-shadow(0 0 5px #b79cff)}
.hint{margin:18px 0 0;min-height:1.6em;font-size:1rem;color:var(--silver-d);text-align:center}
.hint.pulse{color:var(--silver);animation:pulse 2.2s ease-in-out infinite}
@keyframes pulse{50%{opacity:.3}}
.rate{display:flex;gap:14px}
.rate button{background:none;border:0;padding:6px;cursor:pointer;color:var(--ink);opacity:.4;transition:opacity .2s,color .2s}
.rate button:hover,.rate button:focus-visible{opacity:.9}
.rate button[aria-pressed="true"]{opacity:1;color:#6a35d0}
.rate svg{width:18px;height:18px;display:block;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.rate button[aria-pressed="true"] svg{fill:rgba(106,53,208,.25)}
.sparkles{position:absolute;inset:-6px;pointer-events:none;opacity:0;transition:opacity 1s 1s;z-index:400}
.book.open .sparkles{opacity:1}
.tw{position:absolute;background:#fff;filter:drop-shadow(0 0 4px #cdb8ff);clip-path:polygon(50% 0,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0 50%,40% 40%);animation:tw 2.4s ease-in-out infinite}
@keyframes tw{0%,100%{opacity:.1;transform:scale(.5)}50%{opacity:1;transform:scale(1)}}
.topbtn{position:fixed;top:calc(env(safe-area-inset-top,0px) + 14px);right:14px;z-index:20;font-family:var(--f-display);font-size:1.05rem;letter-spacing:.06em;color:var(--silver);background:rgba(20,6,50,.6);border:1px solid var(--silver-d);padding:8px 16px;cursor:pointer}
.topbtn:hover{border-color:#fff}.topbtn b{font-weight:400;color:#cdb8ff}
#log{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;background:rgba(15,5,40,.72);backdrop-filter:blur(6px)}
#log[hidden]{display:none}
.sheet{width:min(92vw,520px);max-height:80dvh;display:flex;flex-direction:column;background:linear-gradient(180deg,#2c1166,#1a0847);border:1px solid var(--silver-d);box-shadow:0 0 50px rgba(140,100,240,.45)}
.sheet header,.sheet footer{display:flex;justify-content:space-between;align-items:center;padding:14px 20px}
.sheet header{border-bottom:1px solid rgba(169,166,196,.35)}
.sheet h2{margin:0;font-family:var(--f-display);font-weight:400;font-size:1.6rem;letter-spacing:.08em}
#logList{overflow:auto;padding:4px 20px}
.item{padding:14px 0;border-bottom:1px solid rgba(169,166,196,.2)}
.item time,.item .rt{font-size:.8rem;color:var(--silver-d)}
.item .rt{margin-left:10px}
.item .w{margin:6px 0;font-weight:700;line-height:1.7;word-break:break-all}
.item .a{margin:0;color:#d9cffb;line-height:1.7;font-size:.95rem}
.empty{color:var(--silver-d);text-align:center;padding:30px 0}

@media (prefers-reduced-motion:reduce){
  .spin,.tw,.hint.pulse{animation:none}
  h1{animation:none}
  .leaf,.book,.answer{transition-duration:.01s!important}
}
</style>
</head>
<body>
<div id="bgMagic" aria-hidden="true"></div>
<canvas id="sky" aria-hidden="true"></canvas>
<main>
  <section class="stage" id="ask">
    <h1>고민을 적으세요</h1>
    <div class="field" id="field">
      <textarea id="worry" maxlength="300" aria-label="고민" placeholder="마음속에 머무는 고민을 이곳에 적어주세요"></textarea>
      <p class="err" id="err" role="alert"></p>
    </div>
    <button class="btn" id="go" type="button">책을 펼치기</button>
  </section>

  <section class="stage" id="readBook" hidden>
    <div class="after" id="after"><button class="btn ghost" id="again" type="button">새로운 고민 적기</button></div>
    <div class="book" id="book" role="group" tabindex="0" aria-label="마법의 책. 터치하면 책장이 넘어갑니다">
      <div class="answer-page">
        <span class="orn">✦</span>
        <p class="answer" id="ansText" role="status" aria-live="polite"></p>
        <div class="rate"><button type="button" data-r="1" aria-label="도움이 됐어요" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg></button><button type="button" data-r="-1" aria-label="아쉬웠어요" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg></button></div>
      </div>
      <div class="sparkles" id="sparkles"></div>
      <div class="spine"></div>
    </div>
    <p class="hint" id="hint"></p>
  </section>
</main>
<button class="topbtn" id="openLog" type="button">오늘의 고민 <b id="count">0</b></button>
<div id="log" hidden role="dialog" aria-modal="true" aria-labelledby="logTitle">
  <div class="sheet">
    <header><h2 id="logTitle">오늘의 고민</h2><button class="btn ghost" id="closeLog" type="button">닫기</button></header>
    <div id="logList"></div>
    <footer><button class="btn ghost" id="clearLog" type="button">오늘 기록 지우기</button></footer>
  </div>
</div>

<script>
const ANSWERS = [
  "서두르지 마세요. 별은 어둠이 깊어질수록 더 또렷하게 빛납니다.",
  "당신이 피하고 있는 그 문이, 열쇠가 맞는 문입니다.",
  "달이 차오르듯 답도 조용히 차오르는 중입니다.",
  "답은 이미 마음속에 있습니다. 이 책은 그것을 소리 내어 읽어줄 뿐입니다.",
  "한 걸음만 내디디세요. 길은 걷는 자의 발밑에서 나타납니다.",
  "두려움은 마법의 문지기입니다. 이름을 불러주면 물러납니다.",
  "놓아야 할 것은 걱정이 아니라, 결과를 쥐고 있으려는 손입니다.",
  "가장 오래 망설인 선택이 가장 오래 빛나기도 합니다.",
  "잠들기 전 숨을 세 번 고르세요. 아침이 새로운 주문을 가져올 것입니다.",
  "당신을 흔드는 바람은 당신을 멀리 데려갈 바람이기도 합니다.",
  "모든 매듭에는 풀리는 순간이 있습니다. 당기지 말고 결을 따라가세요.",
  "타인의 예언은 접어두세요. 당신의 마법은 당신의 목소리로만 깨어납니다.",
  "작은 일 하나를 끝내세요. 큰 안개는 그 뒤에 걷힙니다.",
  "실패한 주문은 없습니다. 아직 완성되지 않은 주문이 있을 뿐입니다.",
  "오래된 책장은 말합니다. 기다림도 하나의 행동이라고.",
  "지금의 어둠은 씨앗이 땅속에 머무는 시간입니다.",
  "남에게 건네는 다정함으로 자신에게도 말을 걸어보세요.",
  "답을 구하기 전에, 정말 묻고 싶은 것이 무엇인지 다시 적어보세요.",
  "당신의 그림자도 당신 편입니다. 함께 걸어가세요.",
  "오늘의 선택은 내일의 당신이 고맙다고 말할 방향이면 충분합니다."
];

/* ---------- 마법진 ---------- */
const $ = id => document.getElementById(id);
function poly(n, step, r, rot){
  const pts = [];
  for (let k = 0; k < n; k++){
    const a = (rot + k * step * 360 / n) * Math.PI / 180;
    pts.push((500 + r * Math.cos(a)).toFixed(1) + ',' + (500 + r * Math.sin(a)).toFixed(1));
  }
  return `<polygon points="${pts.join(' ')}" fill="none" stroke-width="1.6"/>`;
}
function circleSVG(){
  let g = '';
  [480, 452, 396, 330, 170, 60].forEach((r, i) => g += `<circle cx="500" cy="500" r="${r}" fill="none" stroke-width="${i === 0 ? 3 : 1.4}"/>`);
  g += '<circle cx="500" cy="500" r="468" fill="none" stroke-width="1" stroke-dasharray="3 9"/>';
  for (let i = 0; i < 72; i++){
    const a = i * 5 * Math.PI / 180, l = i % 6 === 0 ? 26 : 11;
    g += `<line x1="${500 + 452 * Math.cos(a)}" y1="${500 + 452 * Math.sin(a)}" x2="${500 + (452 - l) * Math.cos(a)}" y2="${500 + (452 - l) * Math.sin(a)}" stroke-width="1.2"/>`;
  }
  g += poly(5, 2, 396, -90) + poly(3, 1, 330, -90) + poly(3, 1, 330, 90) + poly(4, 1, 240, 0) + poly(4, 1, 240, 45) + poly(5, 2, 170, 90);
  for (let k = 0; k < 5; k++){
    const a = (-90 + k * 72) * Math.PI / 180;
    g += `<circle cx="${500 + 396 * Math.cos(a)}" cy="${500 + 396 * Math.sin(a)}" r="18" fill="none" stroke-width="1.6"/>`;
  }
  return `<svg viewBox="0 0 1000 1000" aria-hidden="true"><g class="spin" stroke="currentColor">${g}</g></svg>`;
}
$('bgMagic').innerHTML = circleSVG();

/* ---------- 은빛 별 하늘 ---------- */
const cv = $('sky'), cx = cv.getContext('2d');
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
let W, H, stars = [], motes = [], shoots = [], nextShoot = 2500;
function star4(x, y, R){
  cx.beginPath();
  cx.moveTo(x, y - R);
  cx.quadraticCurveTo(x, y, x + R, y);
  cx.quadraticCurveTo(x, y, x, y + R);
  cx.quadraticCurveTo(x, y, x - R, y);
  cx.quadraticCurveTo(x, y, x, y - R);
  cx.fill();
}
function resize(){
  const d = devicePixelRatio || 1;
  W = innerWidth; H = innerHeight;
  cv.width = W * d; cv.height = H * d;
  cx.setTransform(d, 0, 0, d, 0, 0);
  const t = document.querySelector('h1').getBoundingClientRect();
  stars = Array.from({length: W < 600 ? 70 : 130}, () => {
    const big = Math.random() < .16;
    let x, y, k = 0;
    do { x = Math.random() * W; y = Math.random() * H; k++; }
    while (big && t.width && k < 30 && x > t.left - 50 && x < t.right + 50 && y > t.top - 50 && y < t.bottom + 90);
    return {x, y, r: Math.random() * 1.6 + .5, p: Math.random() * 6.28, s: .6 + Math.random() * 1.6, big};
  });
  motes = Array.from({length: W < 600 ? 18 : 36}, () => ({x: Math.random() * W, y: Math.random() * H, r: Math.random() * 1.4 + .4, v: .15 + Math.random() * .35, p: Math.random() * 6.28}));
}
function draw(t){
  cx.clearRect(0, 0, W, H);
  for (const m of motes){
    if (!reduce){ m.y -= m.v; m.x += Math.sin(t / 1500 + m.p) * .25; if (m.y < -5){ m.y = H + 5; m.x = Math.random() * W; } }
    cx.fillStyle = 'rgba(215,205,255,.35)';
    cx.beginPath(); cx.arc(m.x, m.y, m.r, 0, 6.28); cx.fill();
  }
  for (const s of stars){
    const a = .3 + .7 * (Math.sin(t / 700 * s.s + s.p) * .5 + .5);
    cx.fillStyle = `rgba(233,231,244,${a})`;
    if (s.big){
      cx.shadowColor = 'rgba(220,210,255,.9)'; cx.shadowBlur = 10;
      star4(s.x, s.y, s.r * 5.5);
      cx.shadowBlur = 0;
    } else {
      cx.beginPath(); cx.arc(s.x, s.y, s.r * .8, 0, 6.28); cx.fill();
    }
  }
  if (!reduce){
    if (t > nextShoot){ shoots.push({x: Math.random() * W * .7, y: Math.random() * H * .35, l: 0}); nextShoot = t + 5000 + Math.random() * 6000; }
    shoots = shoots.filter(o => o.l < 60);
    for (const o of shoots){
      o.l++; o.x += 9; o.y += 4.5;
      const g = cx.createLinearGradient(o.x - 80, o.y - 40, o.x, o.y);
      g.addColorStop(0, 'rgba(255,255,255,0)'); g.addColorStop(1, `rgba(255,255,255,${1 - o.l / 60})`);
      cx.strokeStyle = g; cx.lineWidth = 1.6;
      cx.beginPath(); cx.moveTo(o.x - 80, o.y - 40); cx.lineTo(o.x, o.y); cx.stroke();
    }
    requestAnimationFrame(draw);
  }
}
addEventListener('resize', () => { resize(); if (reduce) draw(0); });
resize(); requestAnimationFrame(draw);

/* ---------- 기록(오늘의 고민) ---------- */
const KEY = 'worrybook:v1';
let mem = [];
try { mem = JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { mem = []; }
const persist = () => { try { localStorage.setItem(KEY, JSON.stringify(mem.slice(-200))); } catch (e) {} };
const isToday = t => new Date(t).toDateString() === new Date().toDateString();
function renderLog(){
  const list = mem.filter(e => isToday(e.t)).reverse();
  $('count').textContent = list.length;
  const box = $('logList');
  box.textContent = '';
  if (!list.length){
    const p = document.createElement('p'); p.className = 'empty';
    p.textContent = '오늘 적은 고민이 아직 없어요. 첫 고민을 적어보세요.';
    box.append(p); return;
  }
  list.forEach(e => {
    const d = document.createElement('article'); d.className = 'item';
    const tm = document.createElement('time');
    tm.textContent = new Date(e.t).toLocaleTimeString('ko-KR', {hour: '2-digit', minute: '2-digit'});
    const rt = document.createElement('span'); rt.className = 'rt';
    rt.textContent = e.r === 1 ? '도움이 됐어요' : e.r === -1 ? '아쉬웠어요' : '';
    const w = document.createElement('p'); w.className = 'w'; w.textContent = e.w;
    const a = document.createElement('p'); a.className = 'a'; a.textContent = e.a;
    d.append(tm, rt, w, a); box.append(d);
  });
}
$('openLog').addEventListener('click', () => { renderLog(); $('log').hidden = false; $('closeLog').focus(); });
const closeLog = () => { $('log').hidden = true; $('clearLog').textContent = '오늘 기록 지우기'; $('openLog').focus(); };
$('closeLog').addEventListener('click', closeLog);
$('log').addEventListener('click', e => { if (e.target === $('log')) closeLog(); });
addEventListener('keydown', e => { if (e.key === 'Escape' && !$('log').hidden) closeLog(); });
$('clearLog').addEventListener('click', e => {
  if (e.target.textContent !== '정말 지울까요?'){ e.target.textContent = '정말 지울까요?'; return; }
  mem = mem.filter(x => !isToday(x.t)); persist(); renderLog(); e.target.textContent = '오늘 기록 지우기';
});
renderLog();

/* ---------- 책 ---------- */
const book = $('book'), ask = $('ask'), readBook = $('readBook'), hint = $('hint'), after = $('after'), ansText = $('ansText');
const PAGES = 5, STEP = 130, FLIP_SPAN = (PAGES - 1) * STEP + 800;
let last = -1, timers = [], state = 'idle', cur = null, leaves = [];
const wait = (fn, ms) => timers.push(setTimeout(fn, reduce ? 0 : ms));

// 책 테두리 반짝이
(() => {
  const box = $('sparkles');
  for (let i = 0; i < 26; i++){
    const e = document.createElement('i'); e.className = 'tw';
    const sz = 9 + Math.random() * 9, side = i % 4, pos = Math.random() * 100;
    e.style.width = e.style.height = sz + 'px';
    if (side < 2){ e.style.left = pos + '%'; e.style[side ? 'bottom' : 'top'] = -sz / 2 + 'px'; }
    else { e.style.top = pos + '%'; e.style[side === 2 ? 'left' : 'right'] = -sz / 2 + 'px'; }
    e.style.animationDelay = (Math.random() * 2.4) + 's';
    e.style.animationDuration = (1.6 + Math.random() * 1.8) + 's';
    box.appendChild(e);
  }
})();

function buildLeaves(worry){
  book.querySelectorAll('.leaf').forEach(l => l.remove());
  const total = PAGES + 1;
  for (let i = 0; i < total; i++){
    const leaf = document.createElement('div');
    leaf.className = 'leaf';
    leaf.style.zIndex = 50 - i;
    if (i === 0){
      leaf.innerHTML = `<div class="face cover front"><div class="mc">${circleSVG()}</div><div class="ttl">마법의<br>고민 해결책</div></div><div class="face cover back"></div>`;
    } else {
      const back = i === total - 1
        ? '<div class="face paper back worry"><small>당신의 고민</small><p></p></div>'
        : '<div class="face paper back"></div>';
      leaf.innerHTML = `<div class="face paper front"></div>${back}`;
    }
    book.appendChild(leaf);
  }
  book.querySelector('.worry p').textContent = worry;
  leaves = [...book.querySelectorAll('.leaf')];
}
function pick(){
  let i;
  do { i = Math.floor(Math.random() * ANSWERS.length); } while (i === last);
  last = i; return ANSWERS[i];
}
function syncRate(){
  document.querySelectorAll('.rate button').forEach(b => b.setAttribute('aria-pressed', String(!!cur && cur.r === +b.dataset.r)));
}
function setAnswer(text){ ansText.textContent = text; ansText.classList.remove('show'); syncRate(); }
function flip(leaf, i){ leaf.style.zIndex = 100 + i; leaf.classList.add('flip'); }
function flipPages(){ for (let i = 1; i <= PAGES; i++) wait(() => flip(leaves[i], i), (i - 1) * STEP); }
function finishOpen(){
  ansText.classList.add('show');
  if (!cur.saved){ cur.saved = true; mem.push(cur); persist(); renderLog(); }
  state = 'open';
  hint.className = 'hint'; hint.textContent = '책을 한 번 더 터치하면 다른 해답이 나와요';
  after.classList.add('show');
}

function openBook(worry){
  timers.forEach(clearTimeout); timers = [];
  ask.hidden = true; readBook.hidden = false;
  book.className = 'book reset';
  buildLeaves(worry);
  cur = {t: Date.now(), w: worry, a: pick(), r: 0};
  setAnswer(cur.a);
  after.classList.remove('show');
  hint.className = 'hint pulse'; hint.textContent = '책을 터치하세요';
  state = 'closed';
  void book.offsetWidth;
  book.classList.remove('reset');
  book.focus({preventScroll: true});
}
function openCover(){
  state = 'busy'; hint.className = 'hint'; hint.textContent = '';
  book.classList.add('open'); flip(leaves[0], 0);
  wait(flipPages, 700);
  wait(finishOpen, 700 + FLIP_SPAN + 300);
}
function reroll(){
  state = 'busy'; ansText.classList.remove('show'); hint.textContent = '';
  for (let i = PAGES; i >= 1; i--) wait(() => { leaves[i].style.zIndex = 200 - i; leaves[i].classList.remove('flip'); }, (PAGES - i) * 90);
  const back = (PAGES - 1) * 90 + 900;
  wait(() => { cur.a = pick(); cur.r = 0; persist(); setAnswer(cur.a); renderLog(); }, back);
  wait(flipPages, back + 150);
  wait(finishOpen, back + 150 + FLIP_SPAN + 300);
}
function tap(){ if (state === 'closed') openCover(); else if (state === 'open') reroll(); }
book.addEventListener('click', e => { if (!e.target.closest('.rate')) tap(); });
book.addEventListener('keydown', e => { if (e.target === book && (e.key === 'Enter' || e.key === ' ')){ e.preventDefault(); tap(); } });
document.querySelectorAll('.rate button').forEach(b => b.addEventListener('click', () => {
  if (state !== 'open' || !cur) return;
  const r = +b.dataset.r;
  cur.r = cur.r === r ? 0 : r;
  persist(); syncRate(); renderLog();
}));

function submit(){
  const v = $('worry').value.trim();
  if (!v){
    $('err').textContent = '고민을 한 줄이라도 적어주세요.';
    const f = $('field'); f.classList.remove('shake'); void f.offsetWidth; f.classList.add('shake');
    $('worry').focus(); return;
  }
  $('err').textContent = '';
  openBook(v);
}
$('go').addEventListener('click', submit);
$('worry').addEventListener('keydown', e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) submit(); });
$('worry').addEventListener('input', () => $('err').textContent = '');
$('again').addEventListener('click', () => {
  timers.forEach(clearTimeout); timers = []; state = 'idle';
  readBook.hidden = true; ask.hidden = false;
  $('worry').value = ''; $('worry').focus();
  resize();
});
</script>
</body>
</html>

